# Internet Computer
NEXT_PUBLIC_ICP_NETWORK=ic
NEXT_PUBLIC_IC_HOST=https://icp-api.io

# Internet Identity — mainnet default. For local II (dfx):
# NEXT_PUBLIC_ICP_NETWORK=local
# NEXT_PUBLIC_II_URL=http://rdmx6-jaaaa-aaaaa-aaadq-cai.localhost:4943
NEXT_PUBLIC_II_URL=https://identity.ic0.app

NEXT_PUBLIC_CANISTER_ORCHESTRATOR=
NEXT_PUBLIC_CANISTER_REGISTRY=
NEXT_PUBLIC_CANISTER_RISK=
NEXT_PUBLIC_CANISTER_TREASURY=
NEXT_PUBLIC_CANISTER_METERING=

# $SYN sale (syn_ledger + syn_sale). Local replica: set after `dfx deploy`.
# Mainnet ICP ledger is used when NEXT_PUBLIC_ICP_NETWORK=ic and ICP_LEDGER is unset.
NEXT_PUBLIC_CANISTER_SYN_LEDGER=
NEXT_PUBLIC_CANISTER_SYN_SALE=
NEXT_PUBLIC_CANISTER_ICP_LEDGER=
# Optional fallback ICP/USD until get_sale_info responds. $10.00 → 10000000
NEXT_PUBLIC_SALE_ICP_USD_RATE_E6=10000000
